print("welcome to the tip calculator")
total_bill=float(input("what was the total bill\n"))
tip_percentage=float(input("how much tip would you like to give? 10,12,15\n"))
bill_split=int(input("how many ppl to split the bill?\n"))

percentage=(total_bill*(tip_percentage/100))
tip=round((percentage/bill_split), 2)
bill_with_tip=((percentage+total_bill)/bill_split)

final_bill=round(bill_with_tip, 2)
print(f"each person should pay as tip= {tip}")
print(f"each persons total bill with tip is= {final_bill}")

