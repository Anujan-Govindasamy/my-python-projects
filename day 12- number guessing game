import random
import art1
print(art1.logo)
print("Welcome to the number guessing game ")
print("I am thinking of a number between 1-100")
actual_number=random.randint(1,100)
level=(input("Choose a difficulty Type 'easy' or 'hard'\n"))
end_range=0
if level=="easy":
    end_range=10
elif level=="hard":
    end_range=5

turn=end_range
for attempts in range(1,end_range+1):
    print(f"You have got {turn} chances remaining to guess the number")
    guess_number=int(input("make a guess : "))
    if guess_number>actual_number:
        print("TOO HIGH")
        status=0
        turn-=1
    elif guess_number<actual_number:
        print("TOO LOW ")
        status=0
        turn-=1
    elif guess_number==actual_number:
        turn -= 1
        status=1
        print(f"YOU WON \nwith {turn} turns remaining  ")
        break

if status==0:
    print(f"Sorry u lost all the chances \nThe correct number is : {actual_number}")
