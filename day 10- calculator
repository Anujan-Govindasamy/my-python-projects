#addition function
def add(n1, n2):
    return n1 + n2
# subtraction function
def sub(n1,n2):
    return n1-n2
# multiplication function
def multiply(n1,n2):
    return n1*n2
# division function
def division(n1,n2):
    return n1/n2
values={"+":"addition","-":"subtraction","*":"multiplication","/":"division"}
restart= True
next_step=""
output=0
while restart != False:
    if next_step=="y":
        num1=output
    else:
        num1 = float(input("enter the first number ---->"))

    operation=input("select n operation from below \n + \n - \n * \n / \n enter the operatio selected --->")
    num2=float(input("whats the next number ---->"))
    for key in values:
        if key=="+" and operation=="+":
            output= add(num1,num2)
            print(output)

        elif key=="-"and operation=="-":
            output= sub(num1,num2)
            print(output)

        elif key=="*"and operation=="*":
            output= multiply(num1,num2)
            print(output)

        elif key=="/"and operation=="/":
            output=division(num1,num2)
            print(output)

    next_step=input(f"Type 'y' to continue calculating with {output} or type 'n' to start a new calculation---->")


